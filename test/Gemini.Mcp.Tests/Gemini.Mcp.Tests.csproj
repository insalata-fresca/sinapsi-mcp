<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Gemini.Mcp.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile the server's logic sources directly (mirrors StepCa.Mcp.Tests) so
         the tests exercise the real tool methods AND the internal hardening helpers
         (GeminiValidation / GeminiErrors) without referencing the Web (Sdk.Web)
         server project and without widening those helpers' visibility in the shipped
         assembly. Program.cs (the Web host entrypoint) is intentionally excluded. -->
    <Compile Include="../../src/servers/Gemini.Mcp/GeminiConfig.cs" />
    <Compile Include="../../src/servers/Gemini.Mcp/GeminiCli.cs" />
    <Compile Include="../../src/servers/Gemini.Mcp/GeminiErrors.cs" />
    <Compile Include="../../src/servers/Gemini.Mcp/GeminiValidation.cs" />
    <Compile Include="../../src/servers/Gemini.Mcp/State.cs" />
    <Compile Include="../../src/servers/Gemini.Mcp/AskTool.cs" />
    <Compile Include="../../src/servers/Gemini.Mcp/ImageGenerateTool.cs" />
    <Compile Include="../../src/servers/Gemini.Mcp/ResearchTools.cs" />
    <Compile Include="../../src/servers/Gemini.Mcp/SessionTools.cs" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
  </ItemGroup>

</Project>
