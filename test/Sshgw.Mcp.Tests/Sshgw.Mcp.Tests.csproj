<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Sshgw.Mcp.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile the host's logic sources directly so the security bounds
         (CommandWhitelist, ReadFilePolicy), registry parsing, env-driven options,
         and the tool surface itself can be unit-tested without referencing the Web
         (Sdk.Web) server project. The two public packages below resolve the
         [McpServerTool] attribute and the SSH transport type the tool surface
         depends on; both are nuget.org-only, so no feed is needed. -->
    <Compile Include="../../src/servers/Sshgw.Mcp/CommandWhitelist.cs" />
    <Compile Include="../../src/servers/Sshgw.Mcp/HostKeyPolicy.cs" />
    <Compile Include="../../src/servers/Sshgw.Mcp/ReadFilePolicy.cs" />
    <Compile Include="../../src/servers/Sshgw.Mcp/ServerRegistry.cs" />
    <Compile Include="../../src/servers/Sshgw.Mcp/SshgwOptions.cs" />
    <Compile Include="../../src/servers/Sshgw.Mcp/SshgwValidation.cs" />
    <Compile Include="../../src/servers/Sshgw.Mcp/SshgwErrors.cs" />
    <Compile Include="../../src/servers/Sshgw.Mcp/SshClient.cs" />
    <Compile Include="../../src/servers/Sshgw.Mcp/SshgwTools.cs" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
    <PackageReference Include="SSH.NET" Version="2024.2.0" />
  </ItemGroup>

</Project>
