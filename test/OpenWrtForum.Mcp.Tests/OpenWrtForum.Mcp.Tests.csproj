<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>OpenWrtForum.Mcp.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile the server's logic sources directly so they can be unit-tested
         (including their internal validation / error-scrub types) without a
         ProjectReference to the Web (Sdk.Web) server project. No feed needed —
         the only external package is the public MCP SDK. Program.cs is excluded
         (it wires the Sinapsi.Mcp host + is not under test). -->
    <Compile Include="../../src/servers/OpenWrtForum.Mcp/DiscourseOptions.cs" />
    <Compile Include="../../src/servers/OpenWrtForum.Mcp/DiscourseClient.cs" />
    <Compile Include="../../src/servers/OpenWrtForum.Mcp/ForumTools.cs" />
    <Compile Include="../../src/servers/OpenWrtForum.Mcp/OpenWrtForumValidation.cs" />
    <Compile Include="../../src/servers/OpenWrtForum.Mcp/OpenWrtForumErrors.cs" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
  </ItemGroup>

</Project>
