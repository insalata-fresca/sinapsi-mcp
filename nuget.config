<?xml version="1.0" encoding="utf-8"?>
<!-- Committed feed list is the PUBLIC nuget.org only. Nothing infrastructure-
     specific is baked here: the servers build entirely from nuget.org plus the
     by-project library references, so a clean restore needs no private feed.

     A private feed (for consuming the shared libraries as packages) is opt-in
     and supplied at restore time from the environment, never committed. CI adds
     it with `dotnet nuget add source` driven by the FORGEJO_NUGET_SOURCE /
     FORGEJO_NUGET_TOKEN variables, so no registry URL or identity lands in git. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
