<?xml version="1.0" encoding="utf-8"?>
<!-- Restores shared libraries from the lab's own Forgejo NuGet feed (token via
     the FORGEJO_NUGET_TOKEN env var, supplied as the REGISTRY_TOKEN Actions
     secret in CI). Same consumer pattern as the home-lab services. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="forgejo" value="https://forgejo.insalata-fresca.ch/api/packages/ste/nuget/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <forgejo>
      <add key="Username" value="ste" />
      <add key="ClearTextPassword" value="%FORGEJO_NUGET_TOKEN%" />
    </forgejo>
  </packageSourceCredentials>
</configuration>
