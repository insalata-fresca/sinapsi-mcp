# Sinapsi.SentinelConsole — the Authorization Console (read-only inspection surface).
# Copy to the deploy env; the scoped read-only NATS identity + TLS CA are host-mounted
# by the Quadlet at deploy, never baked into the image.

# HTTP
SENTINEL_CONSOLE_PORT=8140
SENTINEL_CONSOLE_BUFFER=2000
SENTINEL_CONSOLE_DEPLOY_BUFFER=500
SENTINEL_CONSOLE_APPROVAL_BUFFER=1000

# Operator Approval Bridge lane (E1.7, home-server docs/66 §3.5/§6). The pending-queue read +
# Approve/Reject buttons are a transparent proxy to the ApprovalBridge.Broker (E1.3) command API —
# never a bypass of its server-side one-shot / self-approval / CAS checks.
BRIDGE_BROKER_URL=http://127.0.0.1:8013
# Placeholder operator identity the Console approves/rejects AS (server-side only — never taken
# from the browser request). Real per-operator SSO-bound identity is a follow-up once live
# approve-channel authz (E1.5) lands; the broker independently re-checks approver != requester
# regardless of this value.
SENTINEL_CONSOLE_OPERATOR_IDENTITY=operator:console

# NATS (shared connection env). Use a SUBSCRIBE-ONLY identity authorised on
# homelab.security.> — this service never publishes.
#
# FOLLOW-UP REQUIRED (not yet applied — see README "Deploy-visibility lane"):
# M12 added a second subscriber (DeployBusSubscriber) that also listens on
# homelab.release.> + homelab.deploy.> so the Console can answer "did my merge
# actually deploy?" without SSH. It connects with the SAME identity below, so
# that identity's subscribe permissions must be widened in home-server
# (nats_server_users / playbooks/roles/nats_server/) to also authorise
# homelab.release.> + homelab.deploy.> before the deploy lane will show data.
# Until that widening lands, DeployBusSubscriber connects but receives nothing
# — it fails safe (silently idle), not open.
NATS_URL=nats://127.0.0.1:4222
NATS_NKEY_SEED_PATH=/etc/sentinel-console/nats.seed
NATS_NKEY=U...
# NATS_TLS_CA_FILE=/etc/sentinel-console/ca.crt
# NATS_TLS_DISABLE=false

# Dev/first-look only: seed synthetic decisions so the page renders populated with NO
# live bus. Leave UNSET in production.
# SENTINEL_CONSOLE_DEMO=1
