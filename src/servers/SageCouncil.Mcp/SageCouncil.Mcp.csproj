<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>SageCouncil.Mcp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project drives the internal poll-interval seam (fast polling in
         tests; the 10s production default is unchanged). -->
    <InternalsVisibleTo Include="SageCouncil.Mcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The MCP host helpers + the upstream GatewayMcpClient come from the in-repo
         Sinapsi.Mcp library, and the per-member machine-identity minter comes from
         the in-repo Sinapsi.AgentJwt library — both via ProjectReference, so this
         server builds with no private NuGet feed (only nuget.org). The minter is no
         longer vendored into this server. -->
    <ProjectReference Include="../../libs/Sinapsi.Mcp/Sinapsi.Mcp.csproj" />
    <ProjectReference Include="../../libs/Sinapsi.AgentJwt/Sinapsi.AgentJwt.csproj" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
  </ItemGroup>

</Project>
