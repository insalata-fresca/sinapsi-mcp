# ApprovalBridge.Mcp — OCI image. Two-stage: dotnet SDK 8.0 (build/publish) -> aspnet 8.0
# (runtime). Build context is the REPO ROOT so the in-repo ProjectReference to src/libs/
# resolves; restore is nuget.org-only (no private feed, no build secret). Build from the
# repo root:
#   podman build --network=host -f src/servers/ApprovalBridge.Mcp/Containerfile -t <img> .
#
# Runtime deps: bare aspnet + ca-certificates (this server makes an outbound HTTP(S) call to
# the ApprovalBridge.Broker on every tool invocation). Any host-mounted binary or key is
# supplied at DEPLOY by the Quadlet, never baked into the image.

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish src/servers/ApprovalBridge.Mcp/ApprovalBridge.Mcp.csproj \
        -c Release -o /app /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
# ca-certificates: the server makes an outbound HTTPS call to the broker (system trust store).
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /app .
ENV DOTNET_EnableDiagnostics=0
# Documentation only; the listen address is env-driven (<PREFIX>_HOST/_PORT, default
# 0.0.0.0:9219) and overridden by the Quadlet at deploy.
EXPOSE 9219
ENTRYPOINT ["dotnet", "ApprovalBridge.Mcp.dll"]
