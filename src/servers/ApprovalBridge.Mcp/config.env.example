# ApprovalBridge.Mcp — example config (E1.6, the agent-facing REQUEST tool).
#
# This server exposes exactly one MCP tool, approval_bridge_request, which submits a
# {action_id, params} request to the ApprovalBridge.Broker's (E1.3) /request intake under this
# deployment's OWN configured requester identity. It has no approve/reject call anywhere in its
# source (docs/66 §8 T1) — nothing here can ever approve a request.

# ── Listen address (Kestrel) ─────────────────────────────────────────────────────────────────────
ASPNETCORE_URLS=http://0.0.0.0:9219

# ── The ApprovalBridge.Broker (E1.3) this tool calls ────────────────────────────────────────────
# Required. No broker host is baked into the image.
APPROVAL_BRIDGE_BROKER_URL=http://approval-bridge-broker:8013

# ── This deployment's own agent identity ────────────────────────────────────────────────────────
# Required. Sent as requester_identity on every request — never taken from the tool call (docs/66
# §3.1: the agent calls the tool "under its own (agent) identity"). Matches the agent:<id>/<session>
# shape the broker's provenance fields expect (docs/66 §9).
APPROVAL_BRIDGE_REQUESTER_IDENTITY=agent:cervello-worker/ct139

# ── HTTP timeout bounding every call to the broker ──────────────────────────────────────────────
APPROVAL_BRIDGE_HTTP_TIMEOUT_MS=30000
