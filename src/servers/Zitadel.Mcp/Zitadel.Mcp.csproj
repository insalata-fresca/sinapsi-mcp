<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Zitadel.Mcp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The MCP host helpers come from the in-repo lib via ProjectReference, so the
         solution builds without any NuGet feed. Zitadel.Mcp is a thin host over the
         ZITADEL management REST API: a server-local ZitadelClient holds the service
         token server-side and the server-local read-only tool classes expose the
         identity surface (users, projects, OIDC apps). -->
    <ProjectReference Include="../../libs/Sinapsi.Mcp/Sinapsi.Mcp.csproj" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
  </ItemGroup>

</Project>
