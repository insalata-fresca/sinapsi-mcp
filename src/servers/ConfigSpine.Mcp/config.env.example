# ConfigSpine.Mcp — deploy-time environment. Copy to the Quadlet's EnvironmentFile.
# The publish-only nkey SEED is NOT in this file: it is delivered to disk agent-free
# (register-secret Path D) and referenced by path via NATS_NKEY_SEED_PATH.

# --- MCP listen address (env-driven; overridden by the Quadlet) ---
CONFIG_SPINE_MCP_HOST=0.0.0.0
CONFIG_SPINE_MCP_PORT=9216

# --- NATS event spine (the config-event publisher identity) ---
# The shared spine on CT116-nats-server.
NATS_URL=tls://nats.insalata-fresca.ch:4222
# Public key (U...) of the DEDICATED publish-only identity (config-spine-config-emit).
# NON-secret; scoped by ACL to publish: ["homelab.config.>"] only.
NATS_NKEY=U...replace-with-minted-public-key...
# Path to the on-host 0600 file holding the nkey SEED (S...). Delivered by Ansible from
# Infisical /ct121/config-spine-config-emit/NATS_NKEY_SEED (Path D). Never baked in the image.
NATS_NKEY_SEED_PATH=/etc/nats-client/config-spine-config-emit.seed
# Pinned step-ca root for the NATS server's TLS cert.
NATS_TLS_CA_FILE=/etc/nats-client/nats_root_ca.crt

# --- CloudEvents envelope ---
# Must match the reference emit_config_event.py: type = "ch.insalata-fresca." + subject.
CLOUDEVENTS_TYPE_PREFIX=ch.insalata-fresca.
# Producer URI identifying THIS emitter (not the target CT).
CLOUDEVENTS_SOURCE=config-spine-mcp://ct121-mcp-gateway
