<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>StepCa.Mcp</RootNamespace>
    <AssemblyName>StepCa.Mcp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- MCP host helpers come from the in-repo lib via ProjectReference, so the
         project builds from nuget.org alone (no private feed). The only external
         package is the public MCP SDK. -->
    <ProjectReference Include="../../libs/Sinapsi.Mcp/Sinapsi.Mcp.csproj" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
  </ItemGroup>

</Project>
