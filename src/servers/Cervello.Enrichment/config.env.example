# config.env.example — Cervello.Enrichment engine environment knobs (L1).
# All values optional; neutral/local defaults apply when unset. Bool/numeric/URL
# knobs are FAIL-CLOSED: a bad value throws at startup naming the offending env var.
# Secrets (the agent-cervello-enrichment JWK, the DB password, the forgejo/open-points
# bearer) are injected agent-free from Infisical /ct146/cervello/ at deploy — NEVER
# committed, never in the image, never in agent context.

# ── Seam selection (live vs fake) — the DI composition flag ───────────────────
# false (default) = in-memory fakes / offline slice (L1 tests). true = live adapters
# (brain-api / CT126 / CT146 pgvector / forgejo). Switching is CONFIG, never code.
CERVELLO_USE_LIVE_ADAPTERS=false

# ── Phase gate (the E5 gate) ──────────────────────────────────────────────────
# false (default) = ESCALATE-ONLY: the decision policy sends every band to an
# open-point, nothing auto-applies. true = P5 graded bands (auto ≥0.62 / review /
# reject) — flip ONLY after the operator's held-out validation passes.
CERVELLO_GRADED_AUTO_APPLY=false

# ── brain-api (diarize-embed proxy + correction LLM) ──────────────────────────
CERVELLO_BRAIN_API_BASE_URL=http://127.0.0.1:8081
# The scoped agentgateway machine identity the engine mints a bearer for at runtime
# (agent-free — JWK provisioned by the deploy-controller/Infisical pattern). Used for CT126 +
# forgejo egress only — brain-api's /v1/enrich/* routes use the STATIC bearer below, NOT this JWT.
CERVELLO_ENRICHMENT_AGENT=agent-cervello-enrichment
# The STATIC brain-api bearer for the /v1/enrich/* routes (diarize-embed / correct / derive-facts).
# It MUST equal brain-api's own BRAIN_BEARER_TOKEN — those routes validate by plain string-equality
# (the minted agent JWT is NOT accepted there). Injected agent-free at deploy from Infisical
# (/ct121/homelab-state-mcp/BRAIN_BEARER_TOKEN); NEVER commit. Empty in fake mode; LIVE mode FAILS
# CLOSED on an empty value.
# CERVELLO_BRAIN_BEARER_TOKEN=<secret — inject from Infisical at deploy; never commit>
# OIDC (Sinapsi.AgentJwt) — required at mint time in live mode (for the CT126 + forgejo bearer):
# AGENT_KEY_DIR=/etc/agent-jwt/keys
# OIDC_ISSUER=https://id.example
# OIDC_AUDIENCE_PROJECT_ID=<project-id>

# ── CT126 speaches (base transcription + selective re-ASR) ────────────────────
CERVELLO_CT126_BASE_URL=http://10.42.0.126:8000
CERVELLO_TRANSCRIBE_LANGUAGE=fr

# ── CT146 Postgres (voiceprints / attributions / open-points / correction-map / ledger) ─
# Either a full DSN...
# CERVELLO_ENRICHMENT_DB_DSN=Host=127.0.0.1;Port=5432;Database=cervello;Username=cervello
# ...or discrete parts (a full DSN wins if both are set):
CERVELLO_DB_HOST=127.0.0.1
CERVELLO_DB_PORT=5432
CERVELLO_DB_NAME=cervello
CERVELLO_DB_USER=cervello
# CERVELLO_DB_PASSWORD=<secret — inject from Infisical at deploy; never commit>

# ── forgejo map-PR writer (ste/cervello review-PR) ────────────────────────────
CERVELLO_FORGEJO_BASE_URL=https://forgejo.insalata-fresca.ch
CERVELLO_FORGEJO_REPO=ste/cervello
CERVELLO_FORGEJO_BASE_BRANCH=main
# true (default) = DRY-RUN: assemble + self-lint + log the map-PR, open NO real PR
# (the L1 boundary). false = open the live review-PR (L2, on-CT). A human gate merges
# it; cervello-lint re-runs as the pre-merge check. NEVER auto-merged.
CERVELLO_MAP_PR_DRY_RUN=true

# ── open-points MCP bearer gate (private-plane surface) ───────────────────────
# The gate FAILS CLOSED on an empty expected token (a mis-provisioned deploy never
# exposes the tools open). The operator's cervello bearer is injected agent-free:
# CERVELLO_OPEN_POINTS_TOKEN=<secret — inject from Infisical at deploy; never commit>
CERVELLO_OPEN_POINTS_AUTH_ENABLED=true

# ── CT-local paths (custody — git-side transcripts/bundles + CT-side pins/log) ─
CERVELLO_REPO_WORKTREE=/var/lib/cervello/repo
CERVELLO_PIN_DIR=/var/lib/cervello/pins
CERVELLO_ACCESS_LOG=/var/lib/cervello/access.log

# ── HTTP ceiling (fail-closed 1..3600 s) ──────────────────────────────────────
CERVELLO_ENRICHMENT_HTTP_TIMEOUT_SECONDS=100

# NOTE: there is NO NATS configuration here — by design (invariant 3). This binary
# references NEITHER Sinapsi.Nats NOR any NATS client; the enrichment plane never
# touches the shared bus.
