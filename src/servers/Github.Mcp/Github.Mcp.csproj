<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Github.Mcp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The MCP host base + the shared forge tool surface come from the in-repo libs via
         ProjectReference, so the solution builds without any NuGet feed. Github.Mcp is a
         thin host over Sinapsi.Forge: the GitHubForgeClient adapter (raw REST) implements
         the shared IForgeClient, so the same tool classes drive GitHub. -->
    <ProjectReference Include="../../libs/Sinapsi.Mcp/Sinapsi.Mcp.csproj" />
    <ProjectReference Include="../../libs/Sinapsi.Forge/Sinapsi.Forge.csproj" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
  </ItemGroup>

</Project>
