# Bridge.Mcp runtime config — example only; contains PLACEHOLDERS, no real values.
# The deploy role renders /etc/bridge-mcp/config.env from Infisical (register-secret
# Path D for generated keys; Path A/B for vendor-issued tokens).
#
# All variables read by BridgeConfig.FromEnvironment(). No-op if unset (empty
# default means the feature/auth path is disabled until configured).

# ----- Auth -----
# Static bearer token for Phase 1-3 clients (legacy admin token).
# Register in Infisical at /ct<CTID>/bridge-mcp/BRIDGE_BEARER_TOKEN.
BRIDGE_BEARER_TOKEN=<bearer-token>

# ----- Forgejo -----
# Personal access token scoped to the Forgejo user's repos (repo read+write).
# Register in Infisical at /ct<CTID>/bridge-mcp/FORGEJO_PAT.
FORGEJO_PAT=<forgejo-pat>
FORGEJO_BASE_URL=https://forgejo.example.internal
FORGEJO_USER=<forgejo-username>

# ----- Zitadel / OIDC (Phase 4 JWT) -----
ZITADEL_ISSUER=https://auth.example.internal
ZITADEL_CLIENT_ID=<zitadel-client-id>

# ----- Public / resource identity -----
BRIDGE_BASE_URL=https://bridge.example.internal
MCP_RESOURCE_URI=https://bridge.example.internal/mcp

# ----- Storage -----
BRIDGE_REPO_CACHE=/var/lib/bridge-mcp/repos

# ----- Audit -----
# Forgejo repo (owner/name) where audit logs are appended.
AUDIT_REPO=<owner>/<audit-repo>

# ----- Career search -----
# Base URL of the Sinapsi Indexer instance exposing GET /search (CAREER corpus).
CAREER_SEARCH_URL=http://indexer.internal:8009
# Bearer token for the indexer /search route.
# Register in Infisical at /ct<CTID>/bridge-mcp/CAREER_SEARCH_TOKEN.
CAREER_SEARCH_TOKEN=<career-search-token>

# ----- Cervello open-points (S50 L3 Surface A) -----
# Base URL of the token-gated cervello open-points HTTP surface on CT146-cervello (the
# enrichment host, :8147). Routed via the CT121-mcp-gateway PEP (ACCESS.md §8) in prod.
# The bridge calls GET {url}/open-points + POST {url}/open-points/{id}/answer.
CERVELLO_OPEN_POINTS_URL=http://cervello.internal:8147
# The cervello-scoped operator bearer — SAME token the CT146 gate expects. Empty → the
# tools return not_configured. Register in Infisical at /ct<CTID>/bridge-mcp/CERVELLO_OPEN_POINTS_TOKEN.
CERVELLO_OPEN_POINTS_TOKEN=<cervello-open-points-token>
# Emergency-disable master switch (ACCESS.md §7). false/0/no/off severs the cervello Surface A
# tools at the bridge edge, no redeploy. Default true. Also severs the §5 dialogue tools.
CERVELLO_EXPOSED=true

# ----- Cervello dialogue interaction (CB-BRIDGE — design §5) -----
# The 7 net-new dialogue tools (context_pack/search/get/timeline_walk + capture_fact/set_goal/
# link_evidence) forward to the CT146 dialogue backend (CB-BACKEND) behind the CT121 forwarder.
# Pack/object/timeline/capture/goal → the enrichment host :8147; /search → the indexer :8009.
#
# Pack + object + timeline read surface (:8147).
CERVELLO_PACK_URL=http://cervello.internal:8147
# Capture + goal + evidence deposit surface (:8147, same host; distinct var per §5.9).
CERVELLO_CAPTURE_URL=http://cervello.internal:8147
# Dedicated pack/capture bearer. Leave EMPTY to reuse CERVELLO_OPEN_POINTS_TOKEN (the §5.9 default).
# Register in Infisical at /ct<CTID>/bridge-mcp/CERVELLO_PACK_TOKEN only if a dedicated token is chosen.
CERVELLO_PACK_TOKEN=
# Cervello hybrid-search surface → the indexer :8009. CERVELLO_SEARCH_TOKEN == the indexer's
# INDEXER_SEARCH_TOKEN. Empty → cervello_search returns not_configured.
CERVELLO_SEARCH_URL=http://cervello.internal:8009
CERVELLO_SEARCH_TOKEN=<cervello-search-token>
# Default char budget for cervello_context_pack when the caller omits `budget`. Fail-closed 30000.
CERVELLO_PACK_BUDGET_DEFAULT=30000

# ----- Personal-health tools (health-mcp + withings-mcp via the CT121 PEP) -----
# The health_* / withings_* tools are MCP tools/call PROXIES through the CT121-mcp-gateway PEP
# (NOT REST-bearer forwards like cervello). They mint the bridge's scoped agent identity and
# forward through it — the SageCouncil.Mcp pattern. No static backend token is used.
#
# The gateway /mcp endpoint (prod: the CT121 gateway, e.g. http://10.42.0.121:8443/mcp).
GATEWAY_URL=http://127.0.0.1:8443/mcp
# The bridge's scoped agent identity — the JWK file <AGENT_KEY_DIR>/<name>.json the minter signs.
# Empty → the health/withings tools return not_configured. This identity MUST hold an agentgateway
# grant for the health_* + withings_* tools (see README "Deploy follow-up"). Provision it agent-free
# from Infisical + mount the JWK read-only on CT145.
BRIDGE_HEALTH_AGENT=agent-bridge-mcp
# Emergency-disable master switch. false/0/no/off severs the health/withings tools at the bridge
# edge, no redeploy. Default true.
HEALTH_EXPOSED=true
#
# Agent-JWT minter env (Sinapsi.AgentJwt) — shared with any future PEP-calling tool:
#   OIDC_ISSUER                 the Zitadel issuer that mints the agent access token
#   OIDC_AUDIENCE_PROJECT_ID    the project id the minted token is scoped to
#   AGENT_KEY_DIR               dir holding <agent>.json JWKs, mounted read-only (default /etc/agent-jwt/keys)
#   JWT_TTL_MIN                 assertion + cache TTL in minutes (default 15)
OIDC_ISSUER=https://auth.example.internal
OIDC_AUDIENCE_PROJECT_ID=<zitadel-project-id>
AGENT_KEY_DIR=/etc/agent-jwt/keys
JWT_TTL_MIN=15

# ----- Listen -----
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8000
