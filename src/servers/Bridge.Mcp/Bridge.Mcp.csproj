<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Bridge.Mcp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bridge.Mcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared MCP bootstrap + stateless HTTP transport + upstream GatewayMcpClient. -->
    <ProjectReference Include="../../libs/Sinapsi.Mcp/Sinapsi.Mcp.csproj" />
    <!-- Per-agent RFC 7523 JWT minter for the personal-health tools' PEP calls (health/withings). -->
    <ProjectReference Include="../../libs/Sinapsi.AgentJwt/Sinapsi.AgentJwt.csproj" />
    <!-- Forgejo REST API adapter (GiteaForgeClient / IForgeClient). -->
    <ProjectReference Include="../../libs/Sinapsi.Forge/Sinapsi.Forge.csproj" />
    <!-- NATS CloudEvent emission — wired in B4b-9 (bus audit trace); referenced now so the
         solution build graph includes it and the dep is visible to the CI image build. -->
    <ProjectReference Include="../../libs/Sinapsi.Nats/Sinapsi.Nats.csproj" />
    <!-- JWT decode (Microsoft.IdentityModel stack for RS256/ES256 JWKS). -->
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="7.6.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.6.0" />
    <!-- MCP HTTP surface. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
  </ItemGroup>

</Project>
