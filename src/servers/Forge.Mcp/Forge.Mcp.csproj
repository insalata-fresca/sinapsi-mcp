<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Forge.Mcp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The MCP host helpers + the shared forge tool surface come from the in-repo libs
         via ProjectReference, so the solution builds without any NuGet feed. One image;
         FORGE_NAME/FORGE_BASE_URL/FORGE_TOKEN/FORGE_TOOLSETS select Forgejo vs Codeberg
         at runtime. -->
    <ProjectReference Include="../../libs/Sinapsi.Mcp/Sinapsi.Mcp.csproj" />
    <ProjectReference Include="../../libs/Sinapsi.Forge/Sinapsi.Forge.csproj" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
  </ItemGroup>

</Project>
