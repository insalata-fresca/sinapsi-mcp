<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Gemini.Mcp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The MCP host helpers (AddSinapsiMcpServer / MapSinapsiMcp) come from the in-repo
         library via ProjectReference, so this experiment builds without any NuGet feed. -->
    <ProjectReference Include="../../libs/Sinapsi.Mcp/Sinapsi.Mcp.csproj" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
  </ItemGroup>

</Project>
