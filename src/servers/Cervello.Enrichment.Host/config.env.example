# config.env.example — Cervello.Enrichment.Host environment knobs.
# All values are optional; neutral/local defaults apply when unset. Numeric knobs are
# FAIL-CLOSED: a non-numeric or out-of-range value throws at startup, naming the offending
# env var. Secrets (the agent-cervello-enrichment JWK, DB password, open-points token) are
# injected agent-free from Infisical /ct146/cervello/ at deploy — NEVER committed, never in
# the image.
#
# The host reads TWO config blocks: the ENGINE config (Cervello.Enrichment.EnrichmentConfig —
# live-vs-fake, phase gate, endpoints, DSN) and the HOST config (this file's drain-loop knobs).

# ── Engine seam: live vs fake adapters + the phase gate (ESCALATE-ONLY by default) ──
# false (default) = in-memory fakes, fully offline (no DB, no network). true = live
# adapters (brain-api / CT126 / CT146 pgvector / forgejo) — the L2 deploy posture.
CERVELLO_USE_LIVE_ADAPTERS=false
# false (default) = escalate-only: every band → an open-point, NO auto-write. Flip to true
# ONLY after the operator's E5 held-out validation passes. A config change, never code.
CERVELLO_GRADED_AUTO_APPLY=false
# true (default) = map-PR DRY-RUN: assemble + self-lint + log, but open NO real forgejo PR.
CERVELLO_MAP_PR_DRY_RUN=true

# ── Engine endpoints (live mode) ──────────────────────────────────────────────────
CERVELLO_BRAIN_API_BASE_URL=http://127.0.0.1:8081
CERVELLO_ENRICHMENT_AGENT=agent-cervello-enrichment
CERVELLO_CT126_BASE_URL=http://10.42.0.126:8000
CERVELLO_TRANSCRIBE_LANGUAGE=fr
CERVELLO_FORGEJO_BASE_URL=https://forgejo.insalata-fresca.ch
CERVELLO_FORGEJO_REPO=ste/cervello
CERVELLO_FORGEJO_BASE_BRANCH=main
CERVELLO_ENRICHMENT_HTTP_TIMEOUT_SECONDS=100
# OIDC (Sinapsi.AgentJwt) — required at mint time in live mode:
# AGENT_KEY_DIR=/etc/agent-jwt/keys
# OIDC_ISSUER=https://id.example
# OIDC_AUDIENCE_PROJECT_ID=<project-id>
# CERVELLO_OPEN_POINTS_TOKEN=<secret — operator bearer; agent-free at deploy>

# ── On-CT Postgres (shared with the Watcher: the drain reads watcher_recording,
#    the engine owns enrichment_ledger + the pgvector stores) ─────────────────────
# Either a full DSN...
# CERVELLO_ENRICHMENT_DB_DSN=Host=127.0.0.1;Port=5432;Database=cervello;Username=cervello
# ...or discrete parts (a full DSN wins if both are set):
CERVELLO_DB_HOST=127.0.0.1
CERVELLO_DB_PORT=5432
CERVELLO_DB_NAME=cervello
CERVELLO_DB_USER=cervello
# CERVELLO_DB_PASSWORD=<secret — inject from Infisical at deploy; never commit>

# ── Drain loop (this host's own knobs; fail-closed) ─────────────────────────────
# Poll interval between drain cycles (5..3600 s). Default 30.
CERVELLO_ENRICHMENT_POLL_INTERVAL_SECONDS=30
# Max recordings leased per drain cycle (1..1000). Default 16.
CERVELLO_ENRICHMENT_BATCH_SIZE=16

# ── Opaque health heartbeat (the ONLY thing that leaves the CT) ─────────────────
CERVELLO_ENRICHMENT_HEALTH_HOST=0.0.0.0
# Port (fail-closed 1..65535). Default 8147 (one above the Watcher's 8146).
# GET /healthz — 200 once the worker is up, 503 while starting. Opaque body.
CERVELLO_ENRICHMENT_HEALTH_PORT=8147

# NOTE: there is NO NATS configuration here — by design (invariant 3 / D8). This binary
# references neither Sinapsi.Nats nor any NATS client; the "work available" signal is the
# shared `normalized` state row, polled — never a bus message.
