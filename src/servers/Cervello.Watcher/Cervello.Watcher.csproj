<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Cervello.Watcher</RootNamespace>
    <AssemblyName>Cervello.Watcher</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Expose internal seams (config parsers, stores, pairer, normalizer) to the
         test project. -->
    <InternalsVisibleTo Include="Cervello.Watcher.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Read-only Drive access (ServiceAccountCredential + Changes API) is the
         official Google client; Npgsql is the on-CT Postgres data tier. Both are
         public nuget.org packages — no private feed, no NATS client (invariant 3 /
         D8: this binary references NEITHER Sinapsi.Nats NOR any NATS package).
         The manifest YAML is hand-rolled (no YamlDotNet) for a deterministic,
         byte-stable append. -->
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.74.0.4135" />
    <PackageReference Include="Npgsql" Version="8.0.3" />
  </ItemGroup>

</Project>
