# config.env.example — Cervello.Watcher environment knobs (scope-50 P2c).
# All values are optional; neutral/local defaults apply when unset. Numeric knobs
# are FAIL-CLOSED: a non-numeric or out-of-range value throws at startup, naming
# the offending env var. Secrets (the agent-cervello-watcher JWK, DB password) are
# injected agent-free from Infisical /ct146/cervello/ at deploy — NEVER committed,
# never in the image.

# ── Drive access: the existing homelab `gdrive` MCP via the CT121 agentgateway ──
# (M6-refine — supersedes the original read-only Google service-account design).
# CT121-mcp-gateway is already a fixed allowlisted LAN egress peer for this CT
# (cervello_egress_lan_allow, ports 443/8443) — no forward proxy needed.
GATEWAY_URL=http://127.0.0.1:8443/mcp
# The watcher's scoped agentgateway machine identity. JWK provisioned agent-free
# (deploy-controller/Infisical pattern) at <AGENT_KEY_DIR>/agent-cervello-watcher.json.
CERVELLO_WATCHER_AGENT=agent-cervello-watcher
CERVELLO_WATCHER_APP_NAME=cervello-watcher
# OIDC (Sinapsi.AgentJwt) — required at mint time:
# AGENT_KEY_DIR=/etc/agent-jwt/keys
# OIDC_ISSUER=https://id.example
# OIDC_AUDIENCE_PROJECT_ID=<project-id>

# ── Poll loop (fail-closed 5..3600 s) ─────────────────────────────────────────
CERVELLO_WATCHER_POLL_INTERVAL_SECONDS=60
# Drive folder whose changes we keep (client-side scope filter, D3).
CERVELLO_WATCHER_FOLDER_PATH=cervello/recordings
# Optional: skip gdrive_search_files folder-name resolution at startup by
# setting the folder id directly (recommended once known — avoids any ambiguity).
# CERVELLO_WATCHER_FOLDER_ID=<drive-folder-id>
# Per-request gateway HttpClient timeout ceiling (fail-closed 1..3600 s). A hung
# gdrive-mcp call is aborted at this ceiling (the M6 stall guard) and retried.
CERVELLO_WATCHER_HTTP_TIMEOUT_SECONDS=100
# Bounded in-call retry on a TRANSIENT gdrive-mcp failure (gateway 5xx / transport
# error / timeout). 0 disables in-call retry (fail-closed 0..10). Terminal errors
# (4xx, {ok:false} envelopes) are never retried.
CERVELLO_WATCHER_GDRIVE_MAX_RETRIES=3
# Base backoff between retry attempts, ms (exponential: base * 2^attempt; 0..60000).
CERVELLO_WATCHER_GDRIVE_RETRY_BACKOFF_MS=500

# ── Custody (invariant 1 — audio staged ONLY here, NEVER in git) ──────────────
CERVELLO_WATCHER_STAGING_DIR=/var/lib/cervello/staging
# CT-local working tree of ste/cervello where recordings/manifest.yaml is written.
CERVELLO_WATCHER_REPO_WORKTREE=/var/lib/cervello/repo

# ── On-CT Postgres (D4 — cursor + idempotency ledger + pipeline state) ────────
# Either a full DSN...
# CERVELLO_WATCHER_DB_DSN=Host=127.0.0.1;Port=5432;Database=cervello;Username=cervello
# ...or discrete parts (a full DSN wins if both are set):
CERVELLO_DB_HOST=127.0.0.1
CERVELLO_DB_PORT=5432
CERVELLO_DB_NAME=cervello
CERVELLO_DB_USER=cervello
# CERVELLO_DB_PASSWORD=<secret — inject from Infisical at deploy; never commit>

# ── Opaque health heartbeat (health-checks — the ONLY thing that leaves the CT) ─
CERVELLO_WATCHER_HEALTH_HOST=0.0.0.0
# Port (fail-closed 1..65535). Default 8146.
# GET /healthz — 200 once the worker is up, 503 while starting. Opaque body.
CERVELLO_WATCHER_HEALTH_PORT=8146

# NOTE: there is NO NATS configuration here — by design (invariant 3 / D8). This
# binary references neither Sinapsi.Nats nor any NATS client; the "ready for
# enrichment" signal is a LOCAL marker under the staging inbox, never a bus message.
