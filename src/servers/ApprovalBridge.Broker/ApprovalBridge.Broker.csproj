<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>ApprovalBridge.Broker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Expose the internal security core (broker, store, registry, envelope) to this
         service's own test project so the three security invariants can be proven without
         a live NATS or a live executor. -->
    <InternalsVisibleTo Include="ApprovalBridge.Broker.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The MERGED C2 event-plane contracts (EventPlaneChannels, ActCommand /
         IActCommandDispatcher / NullActCommandDispatcher, DeadLetterRouter,
         DecisionEnvelopeContract) + the CloudEvents publisher come from the in-repo lib via
         ProjectReference, so the solution builds with nuget.org only (no private feed). -->
    <ProjectReference Include="../../libs/Sinapsi.Nats/Sinapsi.Nats.csproj" />
    <!-- Server-side param_schema validation (docs/66 §3.1: params ∈ param_schema, deny-by-default). -->
    <PackageReference Include="JsonSchema.Net" Version="7.3.4" />
    <!-- Parse the git-backed allowlist YAML (policies/approval-bridge/actions/<id>.yaml). -->
    <PackageReference Include="YamlDotNet" Version="16.2.1" />
  </ItemGroup>

</Project>
