# ApprovalBridge.Broker — example config (E1.3, SHADOW / deny-by-default).
#
# The default posture is DORMANT: in-memory state, logging emitter, NATS never touched, and dispatch
# is the C2 NullActCommandDispatcher (nothing executes). Only flip BRIDGE_SHADOW_LOCAL_ONLY=false once
# a durable NATS bus + JetStream KV are provisioned — and even then dispatch stays deny-by-default
# until the executor (E1.4) exists and live approve-authz (E1.5) is stood up (an operator-gated
# trust-boundary flip, docs/66 §10). Nothing in this file can turn dispatch live.

# ── Listen address (Kestrel) ─────────────────────────────────────────────────────────────────────
ASPNETCORE_URLS=http://0.0.0.0:8013

# ── Shadow posture ───────────────────────────────────────────────────────────────────────────────
# true  = fully dormant (in-memory store + logging emitter, no bus).  [DEFAULT]
# false = live wiring (durable JetStream KV + CloudEvents emitter). Requires the NATS_* vars below.
BRIDGE_SHADOW_LOCAL_ONLY=true

# ── Allowlist (E1.1) ─────────────────────────────────────────────────────────────────────────────
# Directory of git-backed action YAML (policies/approval-bridge/actions/<id>.yaml), mounted at deploy.
# Empty ⇒ deny-everything (a valid dormant default).
BRIDGE_ACTIONS_DIR=

# ── Pending-state KV bucket (docs/66 §3.1) ───────────────────────────────────────────────────────
BRIDGE_KV_BUCKET=APPROVAL_REQUESTS

# ── CloudEvents producer source URI for emitted facts ────────────────────────────────────────────
BRIDGE_EVENT_SOURCE=approval-bridge-broker://shadow

# ── NATS (only used when BRIDGE_SHADOW_LOCAL_ONLY=false) ──────────────────────────────────────────
# NKey + TLS, from environment (see Sinapsi.Nats NatsConnectionOptions). Never commit a seed.
NATS_URL=nats://127.0.0.1:4222
NATS_NKEY=
NATS_NKEY_SEED_PATH=nats.seed
NATS_TLS_CA_FILE=
# NATS_TLS_DISABLE=true   # plaintext bus (retains nkey auth); opt-in only
CLOUDEVENTS_TYPE_PREFIX=ch.insalata-fresca.
