<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>DeliveryEvaluator.Host</RootNamespace>
    <AssemblyName>DeliveryEvaluator.Host</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeliveryEvaluator.Host.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The C1 evaluator library (Mission C1, PR #112) — the deterministic classifier +
         the DeliveryVerdictEnvelope fact shape. -->
    <ProjectReference Include="../../libs/Sinapsi.DeliveryEvaluator/Sinapsi.DeliveryEvaluator.csproj" />
    <!-- Durable JetStream consumer base + CloudEvents publisher + env-driven
         NatsConnectionOptions (nuget.org only, no private feed). The verdict-fact /
         act-command subject discipline (EventPlaneChannels, NullActCommandDispatcher)
         travels transitively through Sinapsi.DeliveryEvaluator's reference, but is
         referenced here explicitly because the host uses the worker base + publisher. -->
    <ProjectReference Include="../../libs/Sinapsi.Nats/Sinapsi.Nats.csproj" />
  </ItemGroup>

</Project>
