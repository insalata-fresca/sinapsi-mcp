# DeliveryEvaluator.Host — C1 independent delivery risk evaluator (SHADOW / observe-only).
# Copy to the deploy env; the scoped NATS identity (seed) + TLS CA are host-mounted by the
# Quadlet at deploy, never baked into the image. This mirrors the home-server deploy scaffold
# services/delivery-evaluator/config.env.example (the release `config_default`).
#
# SHADOW / observe-only: it publishes verdict FACTS only — there is NO enforcement flag, and the
# host holds no act dispatcher (the act path stays the deny-by-default NullActCommandDispatcher).

# ── NATS ──
NATS_URL=tls://nats.insalata-fresca.ch:4222
# Public key (U...) of the scoped identity delivery-evaluator-authz-emit. NON-secret; ACL-scoped
# to publish: ["homelab.security.authz.>"] + subscribe the merge/deploy change stream. Paste the minted key.
NATS_NKEY=U...replace-with-minted-delivery-evaluator-authz-emit-public-key...
NATS_NKEY_SEED_PATH=/etc/nats-client/delivery-evaluator-authz-emit.seed
NATS_TLS_CA_FILE=/etc/nats-client/root_ca.crt
# CloudEvents `type` namespace for emitted verdict facts (reverse-DNS you own).
CLOUDEVENTS_TYPE_PREFIX=ch.insalata-fresca.

# ── Input: the merge/deploy change stream (durable JetStream consumer on HOMELAB_AUDIT) ──
# EVALUATOR_WATCH_SUBJECTS narrows the homelab.> audit stream to the merge/deploy decision events
# the evaluator grades. Bound with FilterSubjects (plural) under one durable consumer.
EVALUATOR_STREAM=HOMELAB_AUDIT
EVALUATOR_WATCH_SUBJECTS=homelab.git.>,homelab.release.>,homelab.deploy.>
EVALUATOR_DURABLE=delivery-evaluator

# ── Output: verdict FACT tree (Sinapsi.Nats EventPlane VerdictFactSubjectRoot) ──
# homelab.security.authz.delivery-evaluator.<allow|requires-approval|deny>.delivery-risk-evaluator
# (published, not configurable here — shown for operators). Unclassifiable -> delivery.dlq.>.

# ── Health ──
DELIVERY_EVALUATOR_HEALTH_HOST=0.0.0.0
DELIVERY_EVALUATOR_HEALTH_PORT=8014
