# config.env.example — Sinapsi.Indexer environment knobs
# All values are optional; neutral/local defaults apply when unset.
# Numeric knobs are fail-closed: a non-numeric or out-of-range value throws at
# startup, naming the offending env var.

# ── NATS connection ────────────────────────────────────────────────────────────
NATS_URL=nats://127.0.0.1:4222
# NKey public key + seed file for auth (leave unset for anonymous/local dev).
# NATS_NKEY=<public key>
# NATS_NKEY_SEED_PATH=/run/secrets/nats.seed
# TLS CA (pin the internal CA cert). Disable TLS for plaintext local dev:
# NATS_TLS_CA_FILE=/etc/ssl/certs/homelab-ca.crt
# NATS_TLS_DISABLE=true

# ── JetStream consumer ─────────────────────────────────────────────────────────
INDEXER_STREAM=EVENTS
INDEXER_DURABLE=sinapsi-indexer
# Subject filter for git-push events: <prefix>.git.<repo>.push.<branch>
INDEXER_WATCH_SUBJECT=events.git.>

# ── Rescan / debounce (fail-closed ranges: 5..1440 min, 2..3600 s) ────────────
INDEXER_RESCAN_INTERVAL_MIN=60
INDEXER_DEBOUNCE_SEC=15

# ── Embed loop throttles (fail-closed) ────────────────────────────────────────
INDEXER_EMBED_IDLE_SEC=30
INDEXER_EMBED_THROTTLE_MS=50

# ── Postgres (data tier) ───────────────────────────────────────────────────────
INDEXER_DB_HOST=127.0.0.1
INDEXER_DB_PORT=5432
INDEXER_DB_NAME=sinapsi_index
INDEXER_DB_USER=indexer
# INDEXER_DB_PASSWORD=<secret — inject at deploy; never commit>

# ── Repos to index ─────────────────────────────────────────────────────────────
# Comma-separated "source=owner/repo" pairs.
# Example: INDEXER_REPOS=docs=acme/docs,learnings=acme/learnings
INDEXER_REPOS=
FORGE_BASE_URL=https://forge.example.com
INDEXER_REPO_BRANCH=main
INDEXER_CACHE_DIR=/var/lib/sinapsi-indexer/repos
# FORGE_REPO_TOKEN=<read-only token — inject at deploy; never commit>
INDEXER_GIT_USER=git
# Which source name holds the learnings corpus (drives get_learning + get_learnings).
INDEXER_LEARNINGS_SOURCE=learnings

# ── learn / publish_learning ───────────────────────────────────────────────────
LEARN_SUBJECT_PREFIX=events.learn
LEARN_EVENT_SOURCE=sinapsi-indexer://local/
# Scoped publish-only NATS identity for learn events (optional; falls back to NATS_*).
# LEARN_NATS_NKEY=<public key>
# LEARN_NATS_SEED_PATH=/run/secrets/learn-nats.seed

# ── ONNX embedder ─────────────────────────────────────────────────────────────
EMBED_MODEL_PATH=/opt/models/all-MiniLM-L6-v2/model.onnx
EMBED_VOCAB_PATH=/opt/models/all-MiniLM-L6-v2/vocab.txt
# Tokenizer cap (fail-closed 1..8192).
EMBED_MAX_TOKENS=256
# Embedding dimension (fail-closed 1..65536).
EMBED_DIM=384

# ── HTTP listener (health + /mcp + /search) ────────────────────────────────────
INDEXER_HEALTH_HOST=0.0.0.0
# Port (fail-closed 1..65535). Default 8009.
# GET /           — liveness probe (db_ok + schema_ready + nats_ready)
# GET /search     — [M-B3] FTS search: ?q=<query>[&limit=<1-30>][&source=<name>]
# /mcp            — MCP tool surface (search_index, semantic_search, get_learning, publish_learning)
INDEXER_HEALTH_PORT=8009

# ── Capability flags (indexer-generalization, home-server repo docs/architecture/
# indexer-generalization.md) ───────────────────────────────────────────────────
# Every flag defaults to TODAY'S bundled behaviour when unset — leaving all of
# these commented out is a behavioural no-op. A disabled capability wires
# NOTHING (no route/tool/NATS identity), not merely a firewalled one. Booleans
# accept true|false|1|0 (case-insensitive); any other value THROWS at startup
# naming the var (fail-closed — a typo must not silently flip a capability).
#
# INDEXER_CAP_INDEX=true          # the re-scan/upsert engine
# INDEXER_CAP_SEARCH_MCP=true     # MCP read tools (search_index, semantic_search, get_learning)
# INDEXER_CAP_SEARCH_HTTP=true    # the GET /search route
# INDEXER_CAP_LEARN_PUBLISH=true  # publish_learning tool + the LearnPublisher NATS identity
#                                 # (the ONLY shared-bus WRITE capability)
#
# INDEXER_NATS_MODE=shared-bus    # shared-bus (default, push-coalesced IndexerWorker)
#                                 # | isolated (timer-only TimerOnlyIndexWorker — ZERO
#                                 # NATS client for indexing; freshness is
#                                 # INDEXER_RESCAN_INTERVAL_MIN-bounded only)
#                                 # | private (event-driven, SAME push-coalesced
#                                 # IndexerWorker as shared-bus, but connected with a
#                                 # SCOPED nkey to a PRIVATE subject tree + dedicated
#                                 # stream — structurally barred from shared subjects;
#                                 # see docs/architecture/cervello-private-events.md,
#                                 # OPTION-1). Fail-closed at startup: INDEXER_WATCH_SUBJECT
#                                 # must start with "homelab.cervello." and INDEXER_STREAM
#                                 # must equal "CERVELLO_AUDIT" when this mode is private.
#                                 # A bus-isolated, search-only tenant (e.g. a private
#                                 # corpus that must never reach the shared bus AT ALL,
#                                 # not even privately) sets INDEXER_NATS_MODE=isolated AND
#                                 # INDEXER_CAP_LEARN_PUBLISH=false together — that
#                                 # combination is what makes "nothing reaches shared
#                                 # NATS" a property of THIS PROCESS, not just an
#                                 # egress firewall rule. `private` mode reaches NATS,
#                                 # but ONLY its own partitioned tree (auth-layer +
#                                 # config-layer belt-and-braces).
#
# ── private mode (cervello profile) — full env example ────────────────────────
# INDEXER_NATS_MODE=private
# NATS_URL=tls://nats.insalata-fresca.ch:4222
# NATS_NKEY=<cervello-indexer public U...>            # the SCOPED nkey, NOT admin
# NATS_NKEY_SEED_PATH=/etc/nats-client/cervello-indexer.seed
# NATS_TLS_CA_FILE=/etc/nats-client/root_ca.crt
# INDEXER_STREAM=CERVELLO_AUDIT                        # the PRIVATE stream (not HOMELAB_AUDIT)
# INDEXER_DURABLE=sinapsi-indexer-cervello              # distinct cursor
# INDEXER_WATCH_SUBJECT=homelab.cervello.git.>          # CONFIGURABLE private subject
