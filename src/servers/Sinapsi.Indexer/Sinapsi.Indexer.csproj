<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Sinapsi.Indexer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Expose internal members (classifier/scope/title/sha helpers) to the test project. -->
    <InternalsVisibleTo Include="Sinapsi.Indexer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared NATS worker bases + CloudEvents publisher come from the in-repo lib
         via ProjectReference, so the solution builds with no private NuGet feed
         (nuget.org only). The neutral env-driven NatsConnectionOptions is used. -->
    <ProjectReference Include="../../libs/Sinapsi.Nats/Sinapsi.Nats.csproj" />
    <!-- BookChunk model + BookChunker (M3) — the chunk->Document mapper below
         needs Sinapsi.Opds's BookChunk; M4's OpdsSourceScanner will need the
         rest of this library anyway (EpubExtractor/OpdsClient), so this
         reference is added here rather than deferred. -->
    <ProjectReference Include="../../libs/Sinapsi.Opds/Sinapsi.Opds.csproj" />
    <!-- Postgres data tier (tsvector FTS + pgvector). -->
    <PackageReference Include="Npgsql" Version="8.0.3" />
    <!-- C# MCP HTTP surface. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
    <!-- Hybrid half: local ONNX embeddings (all-MiniLM-L6-v2) entirely in C#. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="1.0.1" />
  </ItemGroup>

</Project>
